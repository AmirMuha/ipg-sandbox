<?xml version="1.0" encoding="UTF-8"?>
<!--
  ponytail: hand-authored subset — 3 in-scope operations only (contracts §3).
  Fidelity gap: real Mellat operations are bpPayRequest/bpVerifyRequest/bpReversalRequest and the
  real responses are one comma-joined `return` string. Here operations use the contract names and
  structured response elements. Upgrade path: T023 renames to the real ops + comma-string `return`.
-->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:tns="http://interfaces.core.sw.bps.com/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             targetNamespace="http://interfaces.core.sw.bps.com/"
             name="PaymentGatewayImplService">

  <types>
    <xsd:schema targetNamespace="http://interfaces.core.sw.bps.com/"
                elementFormDefault="qualified">

      <xsd:complexType name="bpVerifyRequestType">
        <xsd:sequence>
          <xsd:element name="terminalId" type="xsd:long"/>
          <xsd:element name="userName" type="xsd:string"/>
          <xsd:element name="userPassword" type="xsd:string"/>
          <xsd:element name="orderId" type="xsd:long"/>
          <xsd:element name="saleOrderId" type="xsd:long"/>
          <xsd:element name="saleReferenceId" type="xsd:long"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="bpResCodeResponseType">
        <xsd:sequence>
          <xsd:element name="ResCode" type="xsd:int"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:element name="bpPaymentRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="terminalId" type="xsd:long"/>
            <xsd:element name="userName" type="xsd:string"/>
            <xsd:element name="userPassword" type="xsd:string"/>
            <xsd:element name="orderId" type="xsd:long"/>
            <xsd:element name="amount" type="xsd:long"/>
            <xsd:element name="localDate" type="xsd:string"/>
            <xsd:element name="localTime" type="xsd:string"/>
            <xsd:element name="additionalData" type="xsd:string"/>
            <xsd:element name="callBackUrl" type="xsd:string"/>
            <xsd:element name="payerId" type="xsd:long"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="bpPaymentRequestResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="ResCode" type="xsd:int"/>
            <xsd:element name="RefId" type="xsd:string"/>
            <xsd:element name="RedirectUrl" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="bpPaymentVerification" type="tns:bpVerifyRequestType"/>
      <xsd:element name="bpPaymentVerificationResponse" type="tns:bpResCodeResponseType"/>

      <xsd:element name="bpReverseTransaction" type="tns:bpVerifyRequestType"/>
      <xsd:element name="bpReverseTransactionResponse" type="tns:bpResCodeResponseType"/>

    </xsd:schema>
  </types>

  <message name="bpPaymentRequestInput">
    <part name="parameters" element="tns:bpPaymentRequest"/>
  </message>
  <message name="bpPaymentRequestOutput">
    <part name="parameters" element="tns:bpPaymentRequestResponse"/>
  </message>
  <message name="bpPaymentVerificationInput">
    <part name="parameters" element="tns:bpPaymentVerification"/>
  </message>
  <message name="bpPaymentVerificationOutput">
    <part name="parameters" element="tns:bpPaymentVerificationResponse"/>
  </message>
  <message name="bpReverseTransactionInput">
    <part name="parameters" element="tns:bpReverseTransaction"/>
  </message>
  <message name="bpReverseTransactionOutput">
    <part name="parameters" element="tns:bpReverseTransactionResponse"/>
  </message>

  <portType name="PaymentGatewayImpl">
    <operation name="bpPaymentRequest">
      <input message="tns:bpPaymentRequestInput"/>
      <output message="tns:bpPaymentRequestOutput"/>
    </operation>
    <operation name="bpPaymentVerification">
      <input message="tns:bpPaymentVerificationInput"/>
      <output message="tns:bpPaymentVerificationOutput"/>
    </operation>
    <operation name="bpReverseTransaction">
      <input message="tns:bpReverseTransactionInput"/>
      <output message="tns:bpReverseTransactionOutput"/>
    </operation>
  </portType>

  <binding name="PaymentGatewayImplBinding" type="tns:PaymentGatewayImpl">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="bpPaymentRequest">
      <soap:operation soapAction=""/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="bpPaymentVerification">
      <soap:operation soapAction=""/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="bpReverseTransaction">
      <soap:operation soapAction=""/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <service name="PaymentGatewayImplService">
    <port name="PaymentGatewayImplPort" binding="tns:PaymentGatewayImplBinding">
      <soap:address location="http://localhost:8080/behpardakht/MellatPaymentGateway"/>
    </port>
  </service>

</definitions>
