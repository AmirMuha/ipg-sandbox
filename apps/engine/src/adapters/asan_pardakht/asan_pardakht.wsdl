<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:tns="http://asanpardakht.ir/services"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             targetNamespace="http://asanpardakht.ir/services"
             name="AsanPardakhtService">
  <types>
    <xsd:schema targetNamespace="http://asanpardakht.ir/services" elementFormDefault="qualified">
      <xsd:element name="Verify">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="merchantConfigurationId" type="xsd:string"/>
            <xsd:element name="token" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="VerifyResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="status" type="xsd:string"/>
            <xsd:element name="amount" type="xsd:long"/>
            <xsd:element name="rrn" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>
  <message name="VerifySoapIn">
    <part name="parameters" element="tns:Verify"/>
  </message>
  <message name="VerifySoapOut">
    <part name="parameters" element="tns:VerifyResponse"/>
  </message>
  <portType name="AsanPardakhtSoap">
    <operation name="Verify">
      <input message="tns:VerifySoapIn"/>
      <output message="tns:VerifySoapOut"/>
    </operation>
  </portType>
  <binding name="AsanPardakhtSoapBinding" type="tns:AsanPardakhtSoap">
    <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="Verify">
      <soap:operation soapAction="http://asanpardakht.ir/services/Verify" style="document"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>
  <service name="AsanPardakhtService">
    <port name="AsanPardakhtSoap" binding="tns:AsanPardakhtSoapBinding">
      <soap:address location="http://localhost:8080/asan_pardakht/services"/>
    </port>
  </service>
</definitions>
