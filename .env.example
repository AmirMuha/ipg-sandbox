# Ports
ENGINE_PORT=8080
WEB_PORT=3000
DASHBOARD_PORT=3000
# Change this if 5432 is already taken on your machine. Both `docker compose` and a bare
# `pnpm dev` read this file, so they always agree on the port.
POSTGRES_PORT=5432
# Only read by the `demo` compose profile (docker compose --profile demo up -d).
DEMO_PORT=8000

# Public origin of the deployed stack (docker-compose.prod.yml bakes this into the client
# bundle; the nginx edge in deploy/nginx/ routes /api/* to engine).
NEXT_PUBLIC_API_URL=http://ipg.sandboxed.ir

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ipg_sandbox

# Engine configuration overrides
# Delays must satisfy 0 <= d < 300 (data-model.md): bounded so CI cannot hang.
DEFAULT_PENDING_SETTLE_DELAY_S=5
DEFAULT_TIMEOUT_DELAY_S=30
# FR-006: per-project transaction history cap. Oldest rows past this are dropped;
# `transactions_total` keeps counting for the lifetime of the project.
DEFAULT_HISTORY_CAP=1000
# Webhook delivery attempts per (transaction, stage) before a delivery is marked failed.
DEFAULT_WEBHOOK_RETRY_MAX=3

# `local` = single shared project, no login. `demo` = email-gated, per-visitor project
# isolation (FR-014). The `demo` compose profile sets this to `demo` itself.
ENGINE_PROFILE=local

# Launch readiness: Authentication & Sessions
SESSION_TTL_DAYS=7
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

# Launch readiness: Live Subscription Billing (Zarinpal PGv4)
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true

# 006-admin-ipg-visibility: comma-separated allowlist of the only accounts allowed to change
# which payment gateways are offered platform-wide. Empty means no admin — the admin controls go
# inert, they are never open to everyone. Matched case-insensitively against the account email.
# Adding or removing an admin requires editing this file and restarting the engine.
ADMIN_EMAILS=amirmuha110@gmail.com,mirzaii4046@gmail.com
